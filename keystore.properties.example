# Copy to keystore.properties (git-ignored) and fill in to sign release builds
# with a stable key. Required for in-app updates: Android refuses to install an
# update signed by a different key than the installed app.
#
# Create the keystore once and keep it safe — lose it and you can never update
# an installed app again, you can only uninstall and reinstall.
#
#   keytool -genkeypair -v \
#     -keystore spendly-release.jks \
#     -alias spendly \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is relative to the repository root.

storeFile=spendly-release.jks
storePassword=CHANGE_ME
keyAlias=spendly
keyPassword=CHANGE_ME
