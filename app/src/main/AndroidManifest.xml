<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to show "tap to confirm" alerts for spends detected from notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The next two exist solely for the in-app updater (Settings > Updates).

      INTERNET is used for exactly two requests, both HTTPS and both only after
      you press Check for updates: read the release feed, and download the APK.
      Nothing about your spending is ever sent - there is no code that reads the
      database and writes it to a socket.

      REQUEST_INSTALL_PACKAGES lets the app hand that APK to Android's installer.
      It does not allow silent installation: the OS still shows its own
      confirmation dialog, which only a privileged system app can bypass.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Package visibility (Android 11+). We only need to resolve human-readable app
      labels for apps that post notifications, so we declare a narrow launcher query
      instead of the heavy-handed QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- So the About links can find a browser on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".SpendlyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spendly">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Spendly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The notification reader. `exported="true"` is required so the system's
          NotificationManagerService can bind it; the BIND_NOTIFICATION_LISTENER_SERVICE
          permission is signature-level, so only the OS can actually do that bind.
          It still does nothing until the user grants notification access in Settings.
        -->
        <service
            android:name=".notify.SpendNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Confirm / Not a spend / Undo buttons on Spendly's own notifications.
          The intent-filter declares exactly the actions we send, so an explicit
          intent always matches its target under Android 15's stricter intent
          matching. exported="false" keeps it private regardless.
        -->
        <receiver
            android:name=".notify.PendingActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.spendly.action.CONFIRM" />
                <action android:name="com.spendly.action.DISMISS" />
                <action android:name="com.spendly.action.UNDO_SAVE" />
            </intent-filter>
        </receiver>

        <!--
          Home-screen widget. exported="false" is correct for widget providers
          since Android 12; the system delivers APPWIDGET_UPDATE through its own
          path, and our own refresh broadcast is same-UID and explicit.
        -->
        <receiver
            android:name=".widget.MonthSpendWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_spend_widget_info" />
        </receiver>

        <!-- Receives PackageInstaller session results for the in-app updater. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.spendly.action.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Grants temporary read access to the CSV export, nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
